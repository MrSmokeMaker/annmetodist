# Supabase Configuration Example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-secret-service-role-key

# Google Gemini API Example
GEMINI_API_KEY=your-gemini-api-key
GEMINI_PROXY_URL=https://your-project.supabase.co/functions/v1/gemini-proxy
GEMINI_MODEL=gemini-3.5-flash

# Zveno AI API Example
ZVENO_API_KEY=your-zveno-api-key
ZVENO_BASE_URL=https://api.zveno.ai/v1
ZVENO_MODEL=deepseek/deepseek-chat
ZVENO_IMAGE_MODEL=google/gemini-2.5-flash-image
